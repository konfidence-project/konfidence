{
  "name": "konfidence-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "all": "pnpm verify && pnpm test:unit && pnpm test:e2e",
    "api:check": "pnpm api:generate && git diff --exit-code -- src/lib/konfidence-api/schema.d.ts",
    "api:generate": "openapi-typescript ../api/openapispec.yaml -o src/lib/konfidence-api/schema.d.ts && oxfmt src/lib/konfidence-api/schema.d.ts",
    "dev": "vite dev --port ${KONFIDENCE_UI_PORT:-5174}",
    "dev:mock": "KONFIDENCE_MOCK_API_PORT=${KONFIDENCE_MOCK_API_PORT:-8092} KONFIDENCE_API_URL=${KONFIDENCE_API_URL:-http://127.0.0.1:${KONFIDENCE_MOCK_API_PORT:-8092}} concurrently --kill-others --names ui,mock-api \"pnpm dev\" \"pnpm dev:mock-api\"",
    "dev:mock-api": "tsx tests/mock-api/server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && tsgo -p ./tsconfig.json --noEmit",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint && pnpm lint:svelte-templates",
    "lint:fix": "oxlint --fix && pnpm lint:svelte-templates:fix",
    "lint:svelte-templates": "eslint \"src/**/*.svelte\"",
    "lint:svelte-templates:fix": "eslint \"src/**/*.svelte\" --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "verify": "pnpm check && pnpm lint && pnpm check:svelte && pnpm fmt:check",
    "test:unit": "vitest run",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/svelte": "^1.27.0",
    "@xyflow/svelte": "^1.6.1",
    "openapi-fetch": "^0.17.0",
    "svelte-i18n": "^4.0.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "@skeletonlabs/skeleton": "^5.0.0",
    "@skeletonlabs/skeleton-svelte": "^5.0.0",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/parser": "^8.62.1",
    "@typescript/native-preview": "7.0.0-dev.20260702.3",
    "@vitest/browser-playwright": "^4.1.8",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.60.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "2.1.1"
  }
}
