# Server
API_ADDR=:8090
API_LOG_LEVEL=info
API_UI_ASSET_PATH=
API_READ_TIMEOUT=10s
API_WRITE_TIMEOUT=10s
API_SHUTDOWN_TIMEOUT=15s

# OIDC
API_OIDC_ENABLED=true
API_OIDC_ISSUER_URL=https://auth.localhost
API_OIDC_TOKEN_URL=
API_OIDC_AUTHORIZATION_URL=
API_OIDC_DEVICE_AUTH_URL=
API_OIDC_USER_INFO_URL=
API_OIDC_JWKS_URL=
API_OIDC_JWKS_CACHE_TTL=15m
API_OIDC_CLIENT_ID=konfidence
API_OIDC_CLIENT_SECRET=konfidence
API_OIDC_SCOPES=openid,profile,email,groups
API_OIDC_REDIRECT_URL=https://api.localhost/api/v1/auth/callback
API_OIDC_ALLOWED_RETURN_HOSTS=ui.localhost
API_OIDC_PKCE_ENABLED=true
API_OIDC_STATE_EXPIRATION=15m

# Session
API_SESSION_COOKIE_NAME=kden-session
API_SESSION_COOKIE_HTTP_ONLY=true
API_SESSION_COOKIE_SECURE=true
API_SESSION_COOKIE_SAME_SITE=None
API_SESSION_EXPIRATION=12h
API_SESSION_STORAGE_TYPE=in-memory
API_SESSION_CLEANUP_INTERVAL=15m

# Database
API_DB_CONNECTION=postgres://test_user:password@localhost:5432/kden?sslmode=disable
API_DB_MAX_CONNS=10
API_DB_MIN_CONNS=5
API_DB_MAX_CONN_LIFETIME=30m
API_DB_MAX_CONN_IDLE_TIME=5m

# Optional direct TLS; local HTTPS is normally terminated by Caddy.
API_TLS_CERT_FILE=
API_TLS_KEY_FILE=

# UI
VITE_KONFIDENCE_API_BASE_URL=https://api.localhost/api
