{
  "name": "konfidence-mock-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "all": "pnpm verify && pnpm test",
    "check": "node ./node_modules/typescript-native/bin/tsc -p ./tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "verify": "pnpm check && pnpm lint && pnpm fmt:check"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.5",
    "fastify-openapi-glue": "^4.11.5"
  },
  "devDependencies": {
    "@konfidence/api-client": "workspace:*",
    "@types/node": "26.6.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "5.0.2"
  }
}
