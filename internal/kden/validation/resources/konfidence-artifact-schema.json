{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloud.konfidence/konfidence-artifact-schema.json",
  "$defs": {
    "component": {
      "properties": {
        "resources": {
          "$ref": "#/$defs/manifestResourcesArray"
        }
      },
      "type": "object"
    },
    "manifestInput": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file/v1",
            "File/v1"
          ]
        }
      },
      "type": "object",
      "required": [
        "type"
      ]
    },
    "manifestResource": {
      "properties": {
        "type": {
          "type": "string",
          "const": "cloud.konfidence.artifact.manifest"
        },
        "input": {
          "$ref": "#/$defs/manifestInput"
        }
      },
      "type": "object",
      "required": [
        "type",
        "input"
      ]
    },
    "manifestResourcesArray": {
      "contains": {
        "$ref": "#/$defs/manifestResource"
      },
      "type": "array",
      "maxContains": 1,
      "minContains": 1
    }
  },
  "oneOf": [
    {
      "required": [
        "components"
      ]
    },
    {
      "required": [
        "resources"
      ]
    }
  ],
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/component"
      },
      "type": "array"
    },
    "resources": {
      "$ref": "#/$defs/manifestResourcesArray"
    }
  },
  "type": "object",
  "title": "Konfidence Artifact",
  "description": "Konfidence-specific validation rules layered on top of the OCM component constructor schema."
}
