{
  "name": "konfidence-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "all": "pnpm verify && pnpm test:unit && pnpm test:e2e",
    "dev": "vite dev",
    "all": "pnpm check && pnpm lint && pnpm test:unit -- --run && pnpm build",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p ./tsconfig.json --noEmit",
    "lint": "oxlint && pnpm lint:svelte-templates",
    "lint:fix": "oxlint --fix && pnpm lint:svelte-templates:fix",
    "lint:svelte-templates": "eslint \"src/**/*.svelte\"",
    "lint:svelte-templates:fix": "eslint \"src/**/*.svelte\" --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "verify": "pnpm check && pnpm lint && pnpm check:svelte && pnpm fmt:check",
    "test:unit": "vitest run",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ui5/webcomponents": "^2.23.2",
    "@ui5/webcomponents-base": "^2.23.2",
    "@ui5/webcomponents-fiori": "^2.23.2",
    "@ui5/webcomponents-icons": "^2.23.2",
    "@xyflow/svelte": "^1.6.1"
  },
  "devDependencies": {
    "@humanspeak/svelte-headless-table": "^6.0.11",
    "@playwright/test": "^1.60.0",
    "@sap-theming/theming-base-content": "^11.36.4",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@typescript-eslint/parser": "^8.62.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "^4.1.8",
    "eslint": "^10.6.0",
    "eslint-plugin-svelte": "^3.20.0",
    "less": "^4.6.7",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "playwright": "^1.60.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "2.1.1"
  }
}
