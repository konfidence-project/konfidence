<!doctype html>
<html lang="en" class="result {{if .Successful}}result--success{{else}}result--failure{{end}}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{{.Title}}</title>
    <style>
        {{.Styles}}
    </style>
</head>
<body>
<div class="brandbar" aria-hidden="true"></div>

<div class="shell">
    <main class="content">
        <section class="card" aria-labelledby="result-title">
            <div class="brand" aria-label="Konfidence">
                <svg
                        class="brand__mark"
                        viewBox="0 0 1024 1024"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true"
                >
                    <path
                            d="M97.7727 716.813C173.083 745.728 330.231 795.755 516.318 795.755C705.147 795.755 852.871 752.194 920.53 727.924C843.012 874.285 689.155 974 512 974C330.397 974 173.272 869.216 97.7727 716.813ZM932.299 319.943C959.069 378.431 974 443.471 974 512C974 512.546 973.989 513.092 973.987 513.637C936.244 512.693 840.695 518.789 653.642 577.549C568.154 604.404 558.251 616.288 439.452 634.693C294.975 657.075 123.714 648.303 67.7117 639.114C56.1791 598.73 50 556.087 50 512C50 444.378 64.5258 380.148 90.6312 322.263C145.292 333.08 303.235 360.2 513.205 360.2C740.459 360.2 895.048 328.428 932.299 319.943ZM512 50C647.696 50 769.73 108.5 854.253 201.658C798.026 211.486 675.03 229.044 513.205 229.044C365.099 229.044 237.323 214.331 167.363 204.307C251.967 109.611 375.022 50 512 50Z"
                    />
                </svg>
                <span class="brand__name">Konfidence</span>
            </div>

            <div class="status-icon" aria-hidden="true">
                {{if .Successful}}
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path
                            d="m5 12.5 4.25 4.25L19 7"
                            fill="none"
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.25"
                    />
                </svg>
                {{else}}
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path
                            d="m7 7 10 10M17 7 7 17"
                            fill="none"
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-width="2.25"
                    />
                </svg>
                {{end}}
            </div>

            <p class="eyebrow">{{.Eyebrow}}</p>
            <h1 id="result-title">{{.Heading}}</h1>
            <p class="message">{{.Message}}</p>

            <div class="instruction">
                <svg
                        viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true"
                >
                    <path
                            d="m8 9 3 3-3 3m5 0h3M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.75"
                    />
                </svg>
                <span>You can safely close this window and return to your terminal.</span>
            </div>
        </section>
    </main>
</div>

<script>
    window.setTimeout(function () { window.close(); }, {{.CloseDelayMilliseconds}});
</script>
</body>
</html>