{
  "name": "konfidence-ui-prototype",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "all": "pnpm verify && pnpm test:unit && pnpm test:e2e",
    "api:check": "bash ../../hack/check-openapi-types.sh ../../api/openapi.yaml src/lib/konfidence-api/schema.d.ts",
    "api:generate": "openapi-typescript ../../api/openapi.yaml -o src/lib/konfidence-api/schema.d.ts && oxfmt src/lib/konfidence-api/schema.d.ts",
    "dev": "vite dev",
    "dev:mock": "KONFIDENCE_API_URL=http://127.0.0.1:8091 concurrently --kill-others --names ui,mock-api \"pnpm dev\" \"pnpm --filter konfidence-mock-api dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && tsgo -p ./tsconfig.json --noEmit",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint && pnpm lint:svelte-templates",
    "lint:fix": "oxlint --fix && pnpm lint:svelte-templates:fix",
    "lint:svelte-templates": "eslint \"src/**/*.svelte\"",
    "lint:svelte-templates:fix": "eslint \"src/**/*.svelte\" --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "verify": "pnpm check && pnpm lint && pnpm check:svelte && pnpm fmt:check",
    "test:unit": "vitest run",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ui5/webcomponents": "^2.26.0",
    "@ui5/webcomponents-base": "^2.26.0",
    "@ui5/webcomponents-fiori": "^2.26.0",
    "@ui5/webcomponents-icons": "^2.26.0",
    "@xyflow/svelte": "^1.6.5",
    "openapi-fetch": "^0.17.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@humanspeak/svelte-headless-table": "^6.2.0",
    "@playwright/test": "^1.62.1",
    "@sap-theming/theming-base-content": "^11.36.5",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/browser-playwright": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "less": "^4.9.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "playwright": "^1.62.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "2.1.1"
  }
}
