# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work
go.work.sum

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~
.backup

.hermit/*

# Do ignore things like bin/k8s/
bin/*/
bin/galaxy
bin/star
bin/ginkgo

# Do not ignore hermit binary and pkg files in bin/
!bin/hermit
!bin/.hermit/
!bin/*.pkg
!bin/.*pkg

# Ignore Helm chart packages
*.tgz

# Generated plain CRDs used by envtest suites and sample validation
test/data/crds/

# Generated validation schemas
.tmp/

# Generated ClusterRole manifests fed to charts/patch-clusterrole.sh
config/rbac/

### Local development ###
local/

.DS_Store

# Node / SvelteKit
node_modules/
.svelte-kit/
build/
*.tsbuildinfo
