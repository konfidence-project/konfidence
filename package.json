{
  "name": "konfidence",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "all": "pnpm --filter konfidence-ui all",
    "mock-api:all": "pnpm --filter konfidence-mock-api all",
    "mock-api:dev": "pnpm --filter konfidence-mock-api dev",
    "mock-api:test": "pnpm --filter konfidence-mock-api test",
    "mock-api:verify": "pnpm --filter konfidence-mock-api verify",
    "ui:dev": "pnpm --filter konfidence-ui dev",
    "ui:dev:mock": "pnpm --parallel --filter konfidence-ui --filter konfidence-mock-api dev:mock",
    "ui:all": "pnpm --filter konfidence-ui all",
    "ui:build": "pnpm --filter konfidence-ui build",
    "ui:start": "pnpm --filter konfidence-ui start",
    "ui:check": "pnpm --filter konfidence-ui check",
    "ui:check:svelte": "pnpm --filter konfidence-ui check:svelte",
    "ui:lint": "pnpm --filter konfidence-ui lint",
    "ui:lint:fix": "pnpm --filter konfidence-ui lint:fix",
    "ui:fmt": "pnpm --filter konfidence-ui fmt",
    "ui:fmt:check": "pnpm --filter konfidence-ui fmt:check",
    "ui:test": "pnpm --filter konfidence-ui test",
    "ui:test:unit": "pnpm --filter konfidence-ui test:unit",
    "ui:test:browser": "pnpm --filter konfidence-ui test:browser",
    "ui:test:e2e": "pnpm --filter konfidence-ui test:e2e",
    "ui:verify": "pnpm --filter konfidence-ui verify"
  }
}
