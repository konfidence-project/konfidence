{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "module": "ESNext",
    "strict": true,
    "target": "ES2024",
    "types": ["$app/types", "node", "svelte", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "scripts/**/*.ts",
    "*.config.ts",
    "*.config.js"
  ]
}
