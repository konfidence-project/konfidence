# Keep the image version aligned with the Playwright version in pnpm-lock.yaml.
FROM mcr.microsoft.com/playwright:v1.62.1-noble

WORKDIR /work

ENV CI=true

RUN npm install --global pnpm@11.9.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages
# The design-system tests compile Svelte directly and need no app prepare scripts.
RUN pnpm install --frozen-lockfile --ignore-scripts

CMD ["pnpm", "ds:test"]
