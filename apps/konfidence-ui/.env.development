# Use the same-origin `/api` path so the browser talks to the Vite dev server,
# which proxies `/api/v1` to the mock API (see `vite.config.ts`). This keeps the
# session cookie on the dashboard origin and avoids the localhost/127.0.0.1
# cross-origin cookie mismatch that breaks the mock SSO login flow.
# Override with a fully qualified URL to develop against another API.
VITE_KONFIDENCE_API_BASE_URL=/api
