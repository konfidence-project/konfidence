{
  "name": "@konfidence/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts",
    "./schema": "./src/schema.d.ts"
  },
  "scripts": {
    "check": "node ./node_modules/typescript-native/bin/tsc -p ./tsconfig.json --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "verify": "pnpm check && pnpm lint && pnpm fmt:check"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.3",
    "typescript-native": "npm:typescript@^7.0.2"
  }
}
