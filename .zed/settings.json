{
  "lsp": {
    "oxlint": {
      "binary": {
        "path": "apps/konfidence-ui/node_modules/.bin/oxlint",
        "arguments": ["--lsp"]
      },
      "initialization_options": {
        "settings": {
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "run": "onType",
          "unusedDisableDirectives": "deny"
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["oxlint", "!eslint", "..."]
    },
    "Svelte": {
      "language_servers": ["oxlint", "eslint", "..."]
    },
    "TypeScript": {
      "language_servers": ["oxlint", "!eslint", "..."]
    }
  }
}
