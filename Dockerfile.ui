FROM ghcr.io/pnpm/pnpm:11.21.0 AS base

WORKDIR /workspace

RUN pnpm runtime set node 24.15.0 -g

FROM base AS builder

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps/konfidence-ui/package.json apps/konfidence-ui/package.json

RUN pnpm install --frozen-lockfile

COPY apps/konfidence-ui/ apps/konfidence-ui/

RUN pnpm ui:build

FROM base

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

COPY --from=builder /workspace/apps/konfidence-ui/package.json apps/konfidence-ui/package.json
COPY --from=builder /workspace/apps/konfidence-ui/build apps/konfidence-ui/build

WORKDIR /workspace/apps/konfidence-ui

EXPOSE 3000

CMD ["node", "build"]
