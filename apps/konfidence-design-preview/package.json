{
  "name": "konfidence-design-preview",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "all": "pnpm verify",
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "node --test src/lib/playground/*.test.ts",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && tsgo -p ./tsconfig.json --noEmit",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint && pnpm lint:svelte-templates",
    "lint:fix": "oxlint --fix && pnpm lint:svelte-templates:fix",
    "lint:svelte-templates": "eslint \"src/**/*.svelte\"",
    "lint:svelte-templates:fix": "eslint \"src/**/*.svelte\" --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "verify": "pnpm check && pnpm lint && pnpm check:svelte && pnpm fmt:check && pnpm test:unit"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@konfidence/design-system": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "@skeletonlabs/skeleton": "^5.0.4",
    "@skeletonlabs/skeleton-svelte": "^5.0.4",
    "@ui5/webcomponents": "^2.28.1",
    "@ui5/webcomponents-icons": "^2.28.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "mode-watcher": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "magic-string": "^1.4.5",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
