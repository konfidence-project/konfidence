{
  "name": "sample-service-2-task-2",
  "type": "k8s-job",
  "dependsOn": ["sample-service-2-task-1"],
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "sample-service-2-task-2-container",
            "image": "alpine:3.22.1",
            "command": [
              "echo",
              "I am task 2 of service 2"
            ]
          }
        ]
      },
      "restartPolicy": "Never"
    },
    "backoffLimit": 4
  }
}