# Identity provider configuration
#
# Which login mode to use.
#   - `stub` (default): local development — the login form assigns a random
#     silly display name without contacting any external IdP.
#   - `oidc`: full OIDC authorization-code flow. Requires the `IDP_*`
#     variables below. Not yet implemented — see docs / TODO in
#     src/lib/server/idp-config.ts.
IDP_TYPE=stub

# --- OIDC settings (only required when IDP_TYPE=oidc) ---

# Base URL of the OpenID Provider (issuer). Discovery is done at
# `${IDP_ISSUER}/.well-known/openid-configuration`.
IDP_ISSUER=

# Client credentials issued by your IdP for this application.
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=

# Where the IdP will redirect back to after authentication. Must exactly
# match one of the redirect URIs registered with the IdP.
IDP_REDIRECT_URI=http://localhost:5173/auth/callback

# Space-separated list of OAuth scopes to request.
IDP_SCOPES=openid profile email

# --- SvelteKit / adapter-node runtime ---

# Public origin of the deployed app. Required by adapter-node for CSRF form
# validation in production. Not needed for `pnpm dev`.
# ORIGIN=https://konfidence.example.com
