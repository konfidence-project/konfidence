{
  "name": "konfidence-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "all": "pnpm verify && pnpm test",
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && node ./node_modules/typescript-native/bin/tsc -p ./tsconfig.json --noEmit",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint && pnpm lint:svelte-templates",
    "lint:fix": "oxlint --fix && pnpm lint:svelte-templates:fix",
    "lint:svelte-templates": "eslint \"src/**/*.svelte\"",
    "lint:svelte-templates:fix": "eslint \"src/**/*.svelte\" --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "verify": "pnpm check && pnpm lint && pnpm check:svelte && pnpm fmt:check",
    "test": "pnpm test:unit && pnpm test:browser && pnpm test:e2e",
    "test:unit": "vitest run --project server",
    "test:browser": "vitest run --project client",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@humanspeak/svelte-headless-table": "^6.4.0",
    "@konfidence/api-client": "workspace:*",
    "@konfidence/design-system": "workspace:*",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@ui5/webcomponents": "^2.27.2",
    "@ui5/webcomponents-icons": "^2.27.2",
    "@xyflow/svelte": "^1.7.0",
    "mode-watcher": "^1.1.0",
    "svelte-tiny-query": "^2.1.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/browser-playwright": "catalog:",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright": "catalog:",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-browser-svelte": "^3.1.0"
  }
}
